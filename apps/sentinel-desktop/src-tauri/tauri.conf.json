{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SentinelAV",
  "version": "0.2.0",
  "identifier": "com.sentinelav.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SentinelAV \u2014 Security Dashboard",
        "width": 1120,
        "height": 780,
        "minWidth": 760,
        "minHeight": 560,
        "backgroundColor": "#0c1423"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
